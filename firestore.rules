rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isGangMember(gangId) {
      return signedIn()
        && exists(/databases/$(database)/documents/gangs/$(gangId)/members/$(request.auth.uid));
    }
    function isGangHand(gangId) {
      return isGangMember(gangId)
        && get(/databases/$(database)/documents/gangs/$(gangId)).data.founderId == request.auth.uid;
    }

    match /gangs/{gangId} {
      allow read: if isGangMember(gangId);
      allow create: if signedIn() && request.resource.data.founderId == request.auth.uid;
      allow update: if isGangHand(gangId);
      allow delete: if isGangHand(gangId);

      match /members/{memberId} {
        allow read: if isGangMember(gangId);
        allow create: if signedIn() && request.auth.uid == memberId;
        allow update: if signedIn() && (request.auth.uid == memberId || isGangHand(gangId));
      }

      match /played_cards/{cardId} {
        allow read: if isGangMember(gangId);
        allow create: if isGangMember(gangId)
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.status == 'inBank';
        allow update: if isGangMember(gangId) && (
          (resource.data.memberId == request.auth.uid
            && resource.data.status == 'inBank'
            && request.resource.data.status == 'pendingExchange')
          || (isGangHand(gangId)
            && resource.data.status == 'pendingExchange'
            && (request.resource.data.status == 'exchanged'
              || request.resource.data.status == 'rejected'))
        );
      }

      match /exchanges/{exchangeId} {
        allow read: if isGangMember(gangId);
        allow create: if isGangMember(gangId)
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isGangHand(gangId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'approved';
      }

      match /feed/{entryId} {
        allow read: if isGangMember(gangId);
        allow write: if false;
      }
    }

    match /invites/{inviteCode} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.founderId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.founderId == request.auth.uid;
    }

    match /users/{userId}/gangs/{gangId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /app_config/distribution {
      allow read: if true;
      allow write: if false;
    }
  }
}
